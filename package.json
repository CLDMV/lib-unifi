{
	"name": "@cldmv/lib-unifi",
	"version": "0.1.0",
	"description": "UniFi Network client library — official Integration API with legacy controller fallback, capability probe and dry-run writes. A slothlet API package.",
	"type": "module",
	"license": "Apache-2.0",
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	],
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24.15.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.15.0",
			"onFail": "error"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CLDMV/lib-unifi.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/lib-unifi/issues"
	},
	"homepage": "https://github.com/CLDMV/lib-unifi#readme",
	"keywords": [
		"unifi",
		"ubiquiti",
		"dns",
		"network",
		"controller",
		"slothlet"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"exports": {
		".": {
			"lib-unifi-dev": {
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"prepack": "npm run build",
		"build": "node scripts/build.mjs",
		"build:ci": "npm run lint && npm run format:check && npm run build",
		"test": "node tests/run-vitest.mjs",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"test:cjs": "node tests/cjs/entry.test.cjs",
		"test:dist": "LIB_UNIFI_TEST_DIST=1 node tests/run-vitest.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"dependencies": {
		"@cldmv/slothlet": ">=3.22.1 <3.24.0"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.5.0",
		"@cldmv/eslint-plugin-jsonv": "^2.0.0",
		"@cldmv/fix-headers": "^2.6.1",
		"@cldmv/jsonv": "^1.2.4",
		"@cldmv/prettier-plugin-jsonv": "^1.2.4",
		"@cldmv/vitest-runner": "^1.11.4",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.1",
		"@eslint/markdown": "^9.0.0",
		"@vitest/coverage-v8": "^5.1.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.16.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"vitest": "^5.1.2"
	}
}
